From a526e74fba5a0b4aec78afce3ae37c2d0227b8e5 Mon Sep 17 00:00:00 2001
From: maco <maco@localhost>
Date: Sat, 17 Oct 2026 14:19:20 +0200
Subject: [PATCH 1/2] virtio-net: avoid cost of -ftrivial-auto-var-init in the
 TX path

virtio_net_flush_tx() declares two iovec arrays of VIRTQUEUE_MAX_SIZE
entries per packet. With -ftrivial-auto-var-init=zero they are cleared
for every transmitted frame, about 32 KiB of memset per packet, which
showed up as 21% of the main loop when sending 1500-byte frames.
Both arrays are fully written before use, so mark them
QEMU_UNINITIALIZED like the arrays in virtqueue_split_pop().
---
 hw/net/virtio-net.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/hw/net/virtio-net.c b/hw/net/virtio-net.c
index 814b99a..91c7857 100644
--- a/hw/net/virtio-net.c
+++ b/hw/net/virtio-net.c
@@ -2752,7 +2752,9 @@ static int32_t virtio_net_flush_tx(VirtIONetQueue *q)
     for (;;) {
         ssize_t ret;
         unsigned int out_num;
-        struct iovec sg[VIRTQUEUE_MAX_SIZE], sg2[VIRTQUEUE_MAX_SIZE + 1], *out_sg;
+        QEMU_UNINITIALIZED struct iovec sg[VIRTQUEUE_MAX_SIZE];
+        QEMU_UNINITIALIZED struct iovec sg2[VIRTQUEUE_MAX_SIZE + 1];
+        struct iovec *out_sg;
         struct virtio_net_hdr vhdr;
 
         elem = virtqueue_pop(q->tx_vq, sizeof(VirtQueueElement));
